# =============================================================================
# Codex Agent — environment configuration
# =============================================================================
# Copy this file to `.env` (next to docker-compose.yml) and fill in the values
# below. `.env` is gitignored.
#
#   cp .env.example .env
#   $EDITOR .env

# -----------------------------------------------------------------------------
# REQUIRED — API auth
# -----------------------------------------------------------------------------

# PIN / password the Android app submits to /api/auth/login.
# Pick anything from a 6-digit PIN to a long passphrase.
API_PIN=replace-with-your-secret-pin

# HMAC secret used to sign bearer tokens issued by the API.
# Generate with:  python -c 'import secrets; print(secrets.token_hex(32))'
API_JWT_SECRET=replace-with-a-long-random-jwt-secret

# Master secret used to derive Fernet keys for at-rest encryption of any
# sensitive value stored in the SQLite DB. Same generation rule as above.
ENCRYPTION_SECRET=replace-with-a-long-random-string

# -----------------------------------------------------------------------------
# OPTIONAL (defaults are sane)
# -----------------------------------------------------------------------------

# How long an issued access token stays valid (seconds). 30 days by default.
# API_TOKEN_TTL_SECONDS=2592000

# Bind address + port for the API. The container uses host networking so
# this is the host port directly (no docker port-publish needed).
# API_HOST=0.0.0.0
# API_PORT=8001

# CORS origins. `*` is fine because the API uses bearer auth (not cookies).
# CORS_ORIGINS=*

# user_id under which all threads + messages are stored in the local SQLite.
# Single-user app, default is 1.
# OWNER_USER_ID=1

# Sliding-window cap on chat history kept per thread (token budget).
# HISTORY_MAX_MESSAGES=40

# Log level: DEBUG, INFO, WARNING, ERROR.
# LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Codex CLI integration
# -----------------------------------------------------------------------------

# Codex sandbox mode: read-only | workspace-write | danger-full-access.
# `danger-full-access` is required for the agent to actually administer the VPS.
# CODEX_SANDBOX=danger-full-access

# Working directory where the Codex agent operates (path on the HOST, because
# the API calls codex via nsenter into the host's mount namespace).
# CODEX_WORKDIR=/root/codex-workspace

# CODEX_HOME on the host. This is where /auth.json lives.
# CODEX_HOME=/root/.codex

# Per-message timeout for the codex subprocess (seconds).
# CODEX_TIMEOUT_SECONDS=600

# -----------------------------------------------------------------------------
# Multi-modal input (photos / voice / audio / video / documents)
# -----------------------------------------------------------------------------

# faster-whisper model used to transcribe voice notes & audio files.
# Options (size / accuracy): tiny (39MB), base (74MB), small (244MB),
# medium (769MB), large-v3 (1.5GB). `base` is a good CPU default.
# WHISPER_MODEL=base

# Where the model weights are cached on disk (mounted volume = persistent).
# WHISPER_CACHE=/data/whisper-cache

# Inbox paths for uploaded attachments. Defaults assume docker-compose
# mounts host `/` at `/host` (the shipped compose file does this).
#  - INBOX_CONTAINER: where the API writes from inside the container
#  - INBOX_HOST: where Codex (running on the host via nsenter) sees them
# INBOX_CONTAINER=/host/root/codex-workspace/inbox
# INBOX_HOST=/root/codex-workspace/inbox
